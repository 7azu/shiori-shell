{
  "folders": {
    "wallpapers": "$PICTURES/Wallpaper",
    "screenshots": "$PICTURES/Screenshots",
    "music": "$MUSIC",
    "languages": "$DOCUMENTS/Languages",
    "books": "$DOCUMENTS/JapaneseBooks",
    "notes": "",
    "projects": ""
  },
  "languageFolders": {},
  "desktop": {
    "visualizer": true,
    "stars": "animated"
  },
  "keys": {
    "mod": "SUPER"
  },
  "night": {
    "mode": "off",
    "schedule": "sun",
    "from": "20:00",
    "until": "07:00",
    "temperature": 4000
  },
  "windows": {
    "gapsIn": 6,
    "gapsOut": 15,
    "borderSize": 1,
    "rounding": 1,
    "roundingPower": 3,
    "activeBorder": "wal:color5",
    "inactiveBorder": "wal:color0",
    "activeOpacity": 90,
    "inactiveOpacity": 78,
    "shadow": true,
    "shadowRange": 28,
    "blur": true,
    "blurSize": 7,
    "blurPasses": 2,
    "animations": true,
    "animSpeed": 1
  },
  "idle": {
    "dim": 3,
    "lock": 4,
    "screenOff": 8,
    "suspend": 25,
    "dimOn": true,
    "lockOn": true,
    "screenOffOn": true,
    "suspendOn": false
  },
  "weather": {
    "enabled": true,
    "place": "",
    "unit": "c"
  },
  "translation": {
    "provider": "auto",
    "ollamaModel": "qwen2.5:7b",
    "ollamaUrl": "http://localhost:11434"
  }
}
